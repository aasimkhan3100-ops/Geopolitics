<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>The Geopolitical Atlas | By Aasim Khan</title>
<style>
:root{--bg:#0b1630;--bg2:#101f42;--card:#15264d;--line:#27396a;--tx:#eef1f8;--mu:#9fabc9;--gold:#c9a95c;--f:#4fb286;--a:#6aa0e8;--o:#e08a6a}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.6 system-ui,Segoe UI,Roboto,sans-serif}
h1,h2,h3{font-family:Georgia,'Times New Roman',serif;margin:0 0 .5rem;line-height:1.2}
nav{position:sticky;top:0;z-index:9;background:#0b1630ee;backdrop-filter:blur(8px);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:.25rem;padding:.5rem 1rem;overflow-x:auto}
nav b{font-family:Georgia,serif;color:var(--gold);margin-right:1rem;white-space:nowrap}
nav a{color:var(--mu);text-decoration:none;padding:.4rem .75rem;border-radius:99px;white-space:nowrap;font-size:.9rem;transition:.2s}
nav a:hover,nav a.on{background:var(--card);color:var(--tx)}
main{max-width:1100px;margin:auto;padding:1.5rem 1rem 4rem}
.hero{text-align:center;padding:3.5rem 1rem 2rem;background:radial-gradient(circle at 50% 0,#1b3166,transparent 70%);border-radius:24px}
.hero h1{font-size:clamp(2rem,6vw,3.8rem);letter-spacing:.08em;color:#fff}.hero p{color:var(--gold);font-size:1.2rem}
input,select,button{font:inherit;color:var(--tx)}
.sb{width:100%;max-width:700px;padding:1rem 1.25rem;border-radius:99px;border:1px solid var(--line);background:var(--bg2);outline:none}
.sb:focus,input:focus,select:focus{border-color:var(--gold)}
.grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));margin:1rem 0}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:1.1rem;box-shadow:0 6px 20px #0005;transition:.25s;cursor:pointer}
.card:hover{transform:translateY(-4px);border-color:var(--gold)}
.card h3{font-size:1.1rem}.card p{color:var(--mu);margin:.25rem 0;font-size:.92rem}
.cat{display:flex;gap:.6rem;flex-wrap:wrap;justify-content:center;margin-top:1.5rem}
.cat a{background:var(--bg2);border:1px solid var(--line);color:var(--tx);padding:.6rem 1rem;border-radius:12px;text-decoration:none;transition:.2s}.cat a:hover{border-color:var(--gold);background:var(--card)}
.sec{display:none}.sec.on{display:block}
h2.t{font-size:1.7rem;margin-top:2rem;border-left:4px solid var(--gold);padding-left:.75rem}
.tag{display:inline-block;font-size:.72rem;padding:.1rem .6rem;border-radius:99px;border:1px solid;margin-right:.3rem}
.FACT{color:var(--f)}.ANALYSIS{color:var(--a)}.OPINION{color:var(--o)}.DISPUTED{color:var(--o)}
.bar{display:flex;gap:.6rem;flex-wrap:wrap;margin:.5rem 0}
.bar input,.bar select{background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:.55rem .8rem}
.btn{background:var(--gold);color:#1a1405;border:0;border-radius:10px;padding:.55rem 1.1rem;font-weight:600;cursor:pointer;transition:.2s}.btn:hover{filter:brightness(1.1)}
.btn.g{background:var(--bg2);color:var(--tx);border:1px solid var(--line)}
.modal{position:fixed;inset:0;background:#000b;display:none;align-items:flex-start;justify-content:center;padding:1rem;overflow:auto;z-index:20}
.modal.on{display:flex}.mb{background:var(--bg2);border:1px solid var(--line);border-radius:20px;max-width:760px;width:100%;padding:1.5rem;margin:2rem 0}
.layer{border:1px solid var(--line);border-radius:12px;margin:.5rem 0;background:var(--card)}
.layer summary{padding:.7rem 1rem;cursor:pointer;font-weight:600;color:var(--gold)}.layer div{padding:0 1rem 1rem;color:#d5dbea}
table{width:100%;border-collapse:collapse}td,th{padding:.6rem;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{color:var(--gold)}
.tl{border-left:2px solid var(--gold);margin-left:.5rem}.tl .card{margin:0 0 1rem 1.2rem;position:relative}
.tl .card:before{content:"";position:absolute;left:-1.7rem;top:1.3rem;width:12px;height:12px;border-radius:50%;background:var(--gold)}
.yr{color:var(--gold);font-family:Georgia,serif;font-size:1.3rem}
.map{background:#0d1e42;border:1px solid var(--line);border-radius:20px;padding:.5rem}
.map svg{width:100%;height:auto}.dot{fill:var(--gold);cursor:pointer;transition:.2s}.dot:hover{fill:#fff;r:9}
.opt{display:block;width:100%;text-align:left;margin:.4rem 0;padding:.7rem 1rem;background:var(--card);border:1px solid var(--line);border-radius:10px;cursor:pointer}.opt:hover{border-color:var(--gold)}
.opt.ok{border-color:var(--f);background:#12402f}.opt.no{border-color:var(--o);background:#4a2a20}
.fc{min-height:140px;display:flex;align-items:center;justify-content:center;text-align:center;font-size:1.2rem}
.src{font-size:.85rem;color:var(--mu)}.mu{color:var(--mu)}
footer{text-align:center;color:var(--mu);padding:2.5rem 1rem;border-top:1px solid var(--line)}
footer a,.by a{color:var(--gold);text-decoration:none}footer a:hover,.by a:hover{text-decoration:underline}
.by{color:var(--mu)!important;font-size:1rem!important;margin:.25rem 0 1.25rem}
.quote{font-family:Georgia,serif;font-style:italic;font-size:1.25rem;color:var(--tx);max-width:640px;margin:0 auto 1rem;padding:0 1rem;border:0}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
</style></head><body>
<nav id="nav"><b>The Geopolitical Atlas <small style="color:var(--mu);font-family:system-ui;font-weight:400">By Aasim Khan</small></b></nav>
<main>
<section class="sec" id="home"><div class="hero"><h1>THE GEOPOLITICAL ATLAS</h1><p>Understand the world. Connect the dots.</p>
<p class="by">By Aasim Khan · <a href="https://www.instagram.com/x_aasim__________" target="_blank" rel="noopener">Instagram @x_aasim__________</a></p>
<input class="sb" id="q" placeholder="Search a country, conflict, leader, treaty, region or geopolitical topic…" autocomplete="off">
<div class="cat" id="cats"></div></div>
<div id="results"></div><div id="homebody"></div></section>
<section class="sec" id="countries"><h2 class="t">Country explorer</h2><div class="bar"><input id="cf" placeholder="Filter countries…"></div><div class="grid" id="cgrid"></div></section>
<section class="sec" id="geopolitics"><h2 class="t">Geopolitics</h2><p class="mu">Each topic opens in layers: simple, detailed, why it matters, examples, key terms, further research.</p><div class="grid" id="tgrid"></div></section>
<section class="sec" id="conflicts"><h2 class="t">Conflicts &amp; crises</h2><p class="mu"><span class="tag FACT">FACT</span><span class="tag DISPUTED">DISPUTED</span><span class="tag ANALYSIS">ANALYSIS</span> labels separate established events from contested claims and interpretation.</p><div class="grid" id="kgrid"></div></section>
<section class="sec" id="geography"><h2 class="t">Geography explorer</h2><p class="mu">Select a strategic chokepoint on the map. This SVG is a placeholder that can later be replaced by a mapping API (Leaflet, Mapbox, D3).</p><div class="map" id="map"></div><div class="card" id="mapinfo" style="cursor:default;margin-top:1rem"><p>Select a marker.</p></div><div class="grid" id="ggrid"></div></section>
<section class="sec" id="research"><h2 class="t">Research mode</h2><div class="bar"><input id="rq" style="flex:1;min-width:240px" value="Why is the Strait of Malacca important?"><button class="btn" id="rgo">Research</button></div><div id="rout"></div></section>
<section class="sec" id="notes"><h2 class="t">Notes library</h2><div class="bar"><input id="nq" placeholder="Search notes…"><select id="nc"></select><select id="nd"><option value="">All levels</option><option>Beginner</option><option>Intermediate</option><option>Advanced</option></select></div><div class="grid" id="ngrid"></div></section>
<section class="sec" id="compare"><h2 class="t">Compare countries</h2><div class="bar"><select id="ca"></select><select id="cb"></select></div><div class="card" style="cursor:default;overflow:auto"><table id="ctab"></table></div></section>
<section class="sec" id="timeline"><h2 class="t">Timeline</h2><div class="tl" id="tl"></div></section>
<section class="sec" id="learn"><h2 class="t">Learning centre</h2><div class="bar" id="qm"></div><div class="card" id="qbox" style="cursor:default"></div></section>
<section class="sec" id="glossary"><h2 class="t">Glossary</h2><div class="bar"><input id="gq" placeholder="Search terms…"></div><div id="gl"></div></section>
</main>
<div class="modal" id="modal"><div class="mb"><button class="btn g" onclick="closeM()" style="float:right">Close</button><div id="mc"></div></div></div>
<footer>
<blockquote class="quote">“A map shows you where the world is. Understanding shows you why it moves.”</blockquote>
<p>Made with love to make geopolitics easy, by <b>Aasim Khan</b>.</p>
<p><a href="https://www.instagram.com/x_aasim__________" target="_blank" rel="noopener">Instagram: @x_aasim__________</a></p>
<p class="src">The Geopolitical Atlas is a sample educational build. Content is simplified; verify figures against official sources before citing.</p>
</footer>
<script>
/* ===== DATA LAYER: replace these functions with fetch() calls to a backend later ===== */
const DB={
countries:Object.entries({
India:"New Delhi|1.43 billion|3.29 million km²|Rupee (INR)|Federal parliamentary republic|Himalaya in the north, Indo-Gangetic plain, long Indian Ocean coastline|Independent in 1947; partition, non-alignment, 1991 economic reforms|Fifth-largest economy; services and IT strong; large agriculture sector|Dominates the northern Indian Ocean; borders China and Pakistan|Russia, USA, France, Japan, Quad partners|UN, BRICS, SCO, G20, Quad|Border management with China, Kashmir, energy security, job creation",
China:"Beijing|1.41 billion|9.6 million km²|Renminbi (CNY)|Single-party socialist state|Mountains and plateau in the west, fertile east, long Pacific coast|Imperial past, 1949 communist founding, post-1978 opening|Largest manufacturing base; second-largest economy|Belt and Road, South China Sea claims, Taiwan question|Russia, Pakistan, many Global South partners|UN Security Council, BRICS, SCO, WTO|Taiwan, tech rivalry with the US, property sector, ageing population",
"United States":"Washington, D.C.|335 million|9.8 million km²|US dollar (USD)|Federal presidential republic|Two ocean coastlines, Rockies, Great Plains, Mississippi basin|Independence 1776; superpower after 1945|Largest economy; dollar is the main reserve currency|Global alliance network and naval reach|NATO members, Japan, South Korea, Australia|UN Security Council, NATO, G7, G20, WTO|China competition, Ukraine support, debt, domestic polarisation",
Russia:"Moscow|144 million|17.1 million km²|Ruble (RUB)|Federal semi-presidential republic|Largest country; Siberia, vast plains, Arctic coast|Tsarist empire, Soviet Union 1922-1991|Energy and mineral exporter|Nuclear arsenal, energy exports, Arctic|Belarus, Iran, North Korea, China ties|UN Security Council, BRICS, SCO, CSTO|War in Ukraine, sanctions, NATO relations, demographic decline",
Pakistan:"Islamabad|240 million|881,913 km²|Rupee (PKR)|Federal parliamentary republic|Indus basin, Balochistan plateau, Arabian Sea coast|Created in 1947; periods of military rule|Agriculture and textiles; recurring debt pressure|Gwadar port, link between South and Central Asia, nuclear state|China, Saudi Arabia, Turkey|UN, OIC, SCO|Economic crisis, terrorism, Afghan border, relations with India",
"United Kingdom":"London|68 million|243,610 km²|Pound sterling (GBP)|Constitutional monarchy, parliamentary democracy|Island state with major North Sea and Atlantic access|Empire, two world wars, Commonwealth, Brexit in 2020|Finance and services hub|Nuclear power, UN Security Council seat, intelligence ties|USA, NATO and European partners, Commonwealth|UN Security Council, NATO, G7, Commonwealth|Post-Brexit trade, cost of living, defence spending",
France:"Paris|68 million|643,801 km²|Euro (EUR)|Unitary semi-presidential republic|Atlantic, Channel and Mediterranean coasts, Alps and Pyrenees|Revolution of 1789, de Gaulle's Fifth Republic|Diversified economy; aerospace, luxury, nuclear energy|Nuclear power, Indo-Pacific territories, EU leadership|Germany, EU states, NATO allies|UN Security Council, NATO, EU, G7|Strategic autonomy, Sahel withdrawal, pension and budget debates",
Germany:"Berlin|84 million|357,022 km²|Euro (EUR)|Federal parliamentary republic|North European plain, Alps in the south, Rhine and Elbe rivers|Divided after 1945, reunified in 1990|Europe's largest economy; export-led industry|Economic anchor of the EU, central European location|France, USA, EU and NATO states|EU, NATO, G7, G20|Energy transition, defence rebuild, industrial competitiveness",
Japan:"Tokyo|124 million|377,975 km²|Yen (JPY)|Constitutional monarchy|Island arc, mountainous, earthquake-prone|Meiji modernisation, 1945 defeat, postwar pacifist constitution|Advanced industry and technology|Sea lanes in the western Pacific; US alliance anchor|USA, Australia, India, South Korea|UN, G7, G20, Quad|Ageing population, China's rise, North Korea threat, defence reform",
Brazil:"Brasília|216 million|8.5 million km²|Real (BRL)|Federal presidential republic|Amazon basin, Brazilian Highlands, long Atlantic coast|Portuguese colony until 1822, military rule 1964-85|Agriculture, mining and oil exporter|Leader of South America, Amazon stewardship|Mercosur partners, China as top trade partner|UN, BRICS, G20, Mercosur|Deforestation, inequality, fiscal policy, political polarisation"}).map(([n,v])=>{const p=v.split("|"),k=["cap","pop","area","cur","gov","geo","hist","eco","strat","allies","orgs","issues"];const o={name:n};k.forEach((x,i)=>o[x]=p[i]);return o}),
topics:Object.entries({
"Power politics":"States pursue their interests using whatever power they have.|Realist theory sees an anarchic world where security and relative power drive state behaviour.|Explains great-power rivalry, arms races and balancing.|US-China rivalry; Cold War|balance of power, realism",
"Alliances":"Countries agree to support each other.|Alliances pool resources and deter rivals but can drag members into wars.|Shapes the security order of regions.|NATO, Quad, Warsaw Pact|collective defence, bandwagoning",
"Soft power":"Influence through attraction rather than force.|Coined by Joseph Nye; culture, values and diplomacy build goodwill.|Cheaper and more lasting than coercion.|Hollywood, Bollywood, K-pop, scholarships|public diplomacy, cultural diplomacy",
"Hard power":"Influence through military and economic force.|Includes armed forces, sanctions and coercive trade.|Still decisive in crises.|Military bases, blockades|coercion, force projection",
"Deterrence":"Preventing attack by threatening costly retaliation.|Relies on credible capability and clear signalling.|Kept the Cold War from turning hot.|Mutually assured destruction|second strike, credibility",
"Sanctions":"Penalties used to change a state's behaviour.|Financial, trade and travel restrictions; effectiveness is debated.|Main alternative to war.|Iran, Russia, North Korea sanctions|embargo, secondary sanctions",
"Trade wars":"Tariffs and counter-tariffs between economies.|Trade tools become instruments of strategy.|Reshape supply chains.|US-China tariffs from 2018|tariff, decoupling, de-risking",
"Proxy conflicts":"Powers fight indirectly through local actors.|Funding, arms and training substitute for direct war.|Prolongs local wars.|Syria, Yemen, Cold War Angola|proxy, patron state",
"Strategic resources":"Resources that give states leverage.|Oil, gas, rare earths, water, semiconductors.|Supply control creates dependence.|Rare earths, lithium|chokepoint, critical minerals",
"Maritime geopolitics":"Control of seas and trade routes.|Navies protect sea lines of communication.|About 80% of world trade moves by sea.|Malacca, Hormuz, South China Sea|SLOC, freedom of navigation",
"Energy geopolitics":"How oil, gas and renewables shape power.|Producers use supply, consumers diversify.|Drives alliances and conflicts.|OPEC+, Nord Stream|energy security, OPEC",
"Global organizations":"Institutions where states cooperate.|UN, WTO, IMF, World Bank and regional bodies set rules.|Provide legitimacy but reflect power gaps.|UN Security Council veto|multilateralism, veto"}).map(([n,v])=>{const p=v.split("|");return{name:n,simple:p[0],detail:p[1],why:p[2],ex:p[3],terms:p[4]}}),
conflicts:[
{name:"Russia-Ukraine war",bg:"Ukraine left the Soviet Union in 1991; tension over NATO and EU orientation grew after 2014.",actors:"Russia, Ukraine, NATO states, EU",causes:"ANALYSIS: security dilemma, contested identity, NATO enlargement debate. DISPUTED: competing narratives about justification.",tl:"2014 Crimea annexation (not recognised by most states); Feb 2022 full-scale invasion.",intl:"Western sanctions and military aid; UN General Assembly resolutions.",status:"Ongoing; check current reporting.",sig:"Tests European security order, energy and grain markets.",terms:"annexation, sovereignty, hybrid war",src:"UN, OSCE, ISW, Reuters (connect later)"},
{name:"Kashmir dispute",bg:"Princely state disputed since 1947 partition.",actors:"India, Pakistan, China, local populations",causes:"FACT: contested accession in 1947. DISPUTED: legal and moral claims.",tl:"1947-48 war; 1965; 1999 Kargil; 2019 constitutional change.",intl:"UN observers; bilateral talks.",status:"Unresolved; periodic tensions.",sig:"Nuclear-armed neighbours; water and border security.",terms:"Line of Control, plebiscite",src:"UN, MEA, MOFA, academic journals"},
{name:"South China Sea disputes",bg:"Overlapping claims over islands and waters.",actors:"China, Vietnam, Philippines, Malaysia, Brunei, Taiwan, USA",causes:"Resources, fishing and trade routes.",tl:"2016 arbitral ruling (rejected by China).",intl:"US freedom of navigation operations.",status:"Ongoing gray-zone incidents.",sig:"Roughly a third of global shipping passes through.",terms:"EEZ, UNCLOS, nine-dash line",src:"PCA, AMTI, UNCLOS text"}],
notes:[
{t:"Types of sovereignty",c:"Political Science",d:"Beginner",s:"Sovereignty means supreme authority within territory.",x:"Internal sovereignty is control at home; external sovereignty is independence abroad. Westphalia 1648 is the usual starting point.",f:"UN Charter Art. 2 stresses sovereign equality.",dt:"1648 Peace of Westphalia",p:"Jean Bodin, Hobbes",k:"sovereignty, recognition",e:"Differentiate de facto and de jure sovereignty.",r:"UN Charter"},
{t:"The Cold War order",c:"International Relations",d:"Intermediate",s:"Rivalry between the US and USSR from 1947 to 1991.",x:"A bipolar world with alliances, arms races and proxy wars.",f:"NATO 1949, Warsaw Pact 1955.",dt:"1947, 1962, 1991",p:"Truman, Stalin, Khrushchev",k:"containment, detente",e:"Cuban Missile Crisis is a frequent question.",r:"Gaddis, The Cold War"},
{t:"India's Non-Alignment",c:"Indian Politics",d:"Intermediate",s:"India avoided formal blocs during the Cold War.",x:"Nehru built the movement with Nasser and Tito; later became strategic autonomy.",f:"NAM founded 1961 in Belgrade.",dt:"1955 Bandung, 1961 Belgrade",p:"Nehru, Nasser, Tito",k:"Panchsheel, NAM",e:"Compare non-alignment and multi-alignment.",r:"MEA archives"},
{t:"Chokepoints and global trade",c:"Geography",d:"Advanced",s:"Narrow passages concentrate trade risk.",x:"Hormuz, Malacca, Suez and Bab-el-Mandeb handle vast energy and container flows.",f:"Suez Canal opened 1869.",dt:"1869, 2021 Ever Given",p:"Alfred Mahan",k:"chokepoint, SLOC",e:"Be able to map the five key straits.",r:"EIA chokepoint reports"}],
terms:Object.entries({Geopolitics:"How geography shapes politics and power.",Sovereignty:"Supreme authority of a state over its territory.",Sanctions:"Economic or diplomatic penalties imposed on a state.",Deterrence:"Discouraging an attack through the threat of retaliation.","Proxy war":"A conflict where outside powers back local sides.","Soft power":"Influence through attraction and culture.","Hard power":"Influence through military or economic coercion.","Bilateral relations":"Relations between two states.",Multilateralism:"Cooperation among three or more states.",Alliance:"Formal agreement to cooperate on security.",NATO:"North Atlantic Treaty Organization, founded 1949.",BRICS:"Group of emerging economies led by Brazil, Russia, India, China, South Africa and others.","Global South":"Loose term for developing and emerging countries.","Strategic autonomy":"Freedom to choose policies without dependence on a bloc.","Buffer state":"A smaller state lying between rival powers.","Sphere of influence":"Region where one power has dominant sway."}).map(([k,v])=>({k,v})),
timeline:[[1945,"United Nations established","50 states sign the Charter in San Francisco."],[1947,"Indian independence","British rule ends; partition creates India and Pakistan."],[1949,"NATO established","Twelve states sign the North Atlantic Treaty."],[1962,"Cuban Missile Crisis","13 days of nuclear brinkmanship between the US and USSR."],[1991,"Soviet Union dissolved","Cold War ends; 15 successor states emerge."],[2001,"September 11 attacks","Triggers the global war on terror."],[2008,"Global financial crisis","Reshapes economic power and creates the G20 leaders' summit."],[2014,"Eastern Europe developments","Russia annexes Crimea; conflict begins in Donbas."],[2020,"Global pandemic","COVID-19 disrupts supply chains and politics worldwide."],[2022,"Russia-Ukraine war begins","Full-scale invasion in February reshapes European security."],["Present","Current developments","Great-power competition, regional wars and shifting alliances; connect a news API here."]],
geo:[["Strait of Malacca",[552,282],"Links the Indian and Pacific oceans; a major route for Gulf oil to East Asia."],["Strait of Hormuz",[470,215],"Narrow gateway from the Persian Gulf; a large share of seaborne oil passes here."],["Suez Canal",[430,198],"Connects the Mediterranean and Red Sea; shortens Europe-Asia trade."],["Bab-el-Mandeb",[450,235],"Red Sea southern gate; vulnerable to regional conflict."],["Bosporus",[438,170],"Turkish straits between the Black Sea and Mediterranean."],["Panama Canal",[210,245],"Joins the Atlantic and Pacific."],["Taiwan Strait",[600,215],"Key shipping lane between China and Taiwan."]],
quiz:[["What year was the UN established?",["1919","1945","1949","1991"],1,"The UN Charter was signed in 1945."],["Which strait links the Indian and Pacific oceans?",["Hormuz","Bosporus","Malacca","Dover"],2,"Malacca links the Andaman Sea and South China Sea."],["Capital of Brazil?",["Rio de Janeiro","São Paulo","Brasília","Salvador"],2,"Brasília became capital in 1960."],["Which is an example of soft power?",["Sanctions","Cultural diplomacy","Naval blockade","Tariffs"],1,"Soft power works through attraction."],["NATO was founded in?",["1945","1949","1955","1962"],1,"The North Atlantic Treaty was signed in April 1949."],["Which country is largest by area?",["China","USA","Russia","Brazil"],2,"Russia covers about 17.1 million km²."],["Which event ended the Cold War era?",["Cuban Missile Crisis","Soviet dissolution","Suez Crisis","Berlin Blockade"],1,"The USSR dissolved in 1991."],["Currency of Japan?",["Yuan","Won","Yen","Rupee"],2,"The yen (JPY)."]]
};
const API={get:async k=>DB[k]}; // swap for fetch('/api/'+k)
/* ===== HELPERS ===== */
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const esc=s=>String(s).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
const CATS=[["🌍","Countries","countries"],["🏛️","Politics","notes"],["⚔️","Conflicts","conflicts"],["🗺️","Geography","geography"],["🤝","International Relations","geopolitics"],["📚","Notes","notes"],["📅","Timelines","timeline"],["🧠","Learn","learn"]];
const PAGES=["home","countries","geopolitics","conflicts","geography","research","notes","compare","timeline","learn","glossary"];
$("#nav").innerHTML+=PAGES.map(p=>`<a href="#${p}" data-p="${p}">${p[0].toUpperCase()+p.slice(1)}</a>`).join("");
$("#cats").innerHTML=CATS.map(c=>`<a href="#${c[2]}">${c[0]} ${c[1]}</a>`).join("");
function route(){const h=(location.hash||"#home").slice(1);const p=PAGES.includes(h)?h:"home";$$(".sec").forEach(s=>s.classList.toggle("on",s.id==p));$$("nav a").forEach(a=>a.classList.toggle("on",a.dataset.p==p));scrollTo(0,0)}
addEventListener("hashchange",route);
function openM(h){$("#mc").innerHTML=h;$("#modal").classList.add("on")}function closeM(){$("#modal").classList.remove("on")}
$("#modal").onclick=e=>{if(e.target.id=="modal")closeM()};addEventListener("keydown",e=>{if(e.key=="Escape")closeM()});
const layer=(t,b,o)=>`<details class="layer" ${o?"open":""}><summary>${t}</summary><div>${b}</div></details>`;
const srcBox=s=>`<p class="src"><span class="tag FACT">FACT</span><span class="tag ANALYSIS">ANALYSIS</span><span class="tag OPINION">OPINION</span><br><b>Sources &amp; further reading:</b> ${esc(s||"Official government sites, UN and international organizations, academic journals, reputable news outlets (to be connected).")}</p>`;
/* ===== COUNTRIES ===== */
const CL=[["cap","Capital"],["pop","Population"],["area","Area"],["cur","Currency"],["gov","Government"],["geo","Geography"],["hist","History"],["eco","Economy"],["strat","Strategic importance"],["allies","Major allies"],["orgs","International organizations"],["issues","Current issues"]];
function showCountry(n){const c=DB.countries.find(x=>x.name==n);openM(`<h2>${esc(c.name)}</h2><p class="mu">${c.cap} · ${c.pop} · ${c.area}</p>`+layer("Quick summary",`${esc(c.gov)}. ${esc(c.strat)}.`,1)+layer("Understand",`<b>Geography:</b> ${c.geo}<br><b>History:</b> ${c.hist}<br><b>Economy:</b> ${c.eco}`)+layer("Deep dive",`<b>Allies:</b> ${c.allies}<br><b>Organizations:</b> ${c.orgs}<br><b>Current issues:</b> ${c.issues}`)+layer("Research further","Search the Research page for this country's chokepoints, treaties and leaders.")+srcBox())}
function renderCountries(){const f=$("#cf").value.toLowerCase();$("#cgrid").innerHTML=DB.countries.filter(c=>c.name.toLowerCase().includes(f)).map(c=>`<div class="card" tabindex="0" onclick="showCountry('${c.name}')"><h3>${c.name}</h3><p>${c.cap} · ${c.pop}</p><p>${c.gov}</p></div>`).join("")||"<p class='mu'>No match. Try another name.</p>"}
$("#cf").oninput=renderCountries;
/* ===== TOPICS / CONFLICTS ===== */
$("#tgrid").innerHTML=DB.topics.map((t,i)=>`<div class="card" onclick="showTopic(${i})"><h3>${t.name}</h3><p>${t.simple}</p></div>`).join("");
function showTopic(i){const t=DB.topics[i];openM(`<h2>${t.name}</h2>`+layer("Simple explanation",t.simple,1)+layer("Detailed explanation",t.detail)+layer("Why it matters",t.why)+layer("Key examples",t.ex)+layer("Key terms",t.terms)+layer("Further research","Search the notes library or Research mode for this topic.")+srcBox())}
$("#kgrid").innerHTML=DB.conflicts.map((c,i)=>`<div class="card" onclick="showConflict(${i})"><h3>${c.name}</h3><p>${c.bg}</p></div>`).join("");
function showConflict(i){const c=DB.conflicts[i],t=s=>s.replace(/(FACT|DISPUTED|ANALYSIS):/g,'<span class="tag $1">$1</span>');openM(`<h2>${c.name}</h2>`+layer("Background",c.bg,1)+layer("Main actors",c.actors)+layer("Causes",t(c.causes))+layer("Timeline and major events",c.tl)+layer("International involvement",c.intl)+layer("Current status",c.status)+layer("Geopolitical significance",c.sig)+layer("Key terminology",c.terms)+srcBox(c.src))}
/* ===== GEOGRAPHY ===== */
$("#map").innerHTML=`<svg viewBox="0 0 800 400"><g fill="#1c3566" stroke="#27396a"><path d="M80 90l120-30 70 40 30 70-40 60-60 90-50-40-20-80-70-40z"/><path d="M360 80l80-20 60 30 120 0 90 40-30 70-90 40-50 90-60-70-40-60-60-30z"/><path d="M570 280l90 0 40 40-60 40-70-30z"/></g>${DB.geo.map((g,i)=>`<circle class="dot" r="7" cx="${g[1][0]}" cy="${g[1][1]}" tabindex="0" onclick="geoShow(${i})" onkeydown="if(event.key=='Enter')geoShow(${i})"><title>${g[0]}</title></circle>`).join("")}</svg>`;
function geoShow(i){const g=DB.geo[i];$("#mapinfo").innerHTML=`<h3>${g[0]}</h3><p>${g[2]}</p>`}
const GG={"Physical geography":"Mountains, rivers, plains and climate","Political geography":"Borders, states and territory","Borders":"Land and maritime boundaries","Mountains":"Himalaya, Andes, Alps, Rockies","Rivers":"Nile, Amazon, Yangtze, Indus","Oceans":"Pacific, Atlantic, Indian, Arctic, Southern","Seas":"South China, Mediterranean, Black, Caspian","Straits":"Malacca, Hormuz, Bosporus, Dover","Strategic waterways":"Suez, Panama, Bab-el-Mandeb","Natural resources":"Oil, gas, rare earths, water","Important ports":"Singapore, Shanghai, Rotterdam, Gwadar","Hotspots":"South China Sea, Kashmir, Eastern Europe"};
$("#ggrid").innerHTML=Object.entries(GG).map(([k,v])=>`<div class="card" style="cursor:default"><h3>${k}</h3><p>${v}</p></div>`).join("");
/* ===== RESEARCH ===== */
const R={malacca:["The Strait of Malacca is the shortest sea link between the Indian and Pacific oceans, carrying a large share of global trade and East Asia's energy imports.","Lies between the Malay Peninsula and Sumatra; a corridor roughly 800 km long.","Narrowest point is under 3 km at the Phillips Channel off Singapore.","Chokepoint for Gulf oil going to China, Japan and South Korea. Often cited in the 'Malacca dilemma' debate.","Indonesia, Malaysia, Singapore (littoral states); China, India, Japan, USA (users).","Container traffic, energy transit, and Singapore's port economy.","Piracy (reduced since 2005), collisions, terrorism, naval rivalry.","Alternatives such as Lombok and Sunda straits, and the Kra Canal idea, are debated.","It is a trade artery and a strategic pressure point; its narrowness creates vulnerability."]};
function research(){const q=$("#rq").value,m=/malacca/i.test(q);const S=["Quick answer","Background","Geography","Strategic importance","Major actors","Economic importance","Security issues","Current relevance","Key takeaways"];const d=m?R.malacca:S.map((s,i)=>i==0?"Sample answer engine: connect an API or database here to generate a full answer for \""+esc(q)+"\".":"Content for this section will be filled by your backend. Try the Malacca example.");$("#rout").innerHTML=`<h3>${esc(q)}</h3>`+S.map((s,i)=>layer(`${i+1}. ${s}`,`<span class="tag ${i==3?'ANALYSIS':'FACT'}">${i==3?'ANALYSIS':'FACT'}</span> ${d[i]}`,i<2)).join("")+layer("10. Sources",srcBox("Placeholder: IMO, UNCTAD, EIA, national maritime authorities, academic journals."))}
$("#rgo").onclick=research;$("#rq").onkeydown=e=>{if(e.key=="Enter")research()};research();
/* ===== NOTES ===== */
$("#nc").innerHTML="<option value=''>All categories</option>"+["Geography","Political Science","International Relations","History","Economics","Current Affairs","Indian Politics","World Politics","International Organizations"].map(c=>`<option>${c}</option>`).join("");
function renderNotes(){const q=$("#nq").value.toLowerCase(),c=$("#nc").value,d=$("#nd").value;$("#ngrid").innerHTML=DB.notes.filter(n=>(!c||n.c==c)&&(!d||n.d==d)&&(n.t+n.s).toLowerCase().includes(q)).map(n=>`<div class="card" onclick="showNote('${n.t.replace(/'/g,"\\'")}')"><h3>${n.t}</h3><p>${n.c} · ${n.d}</p><p>${n.s}</p></div>`).join("")||"<p class='mu'>No notes match these filters.</p>"}
["nq","nc","nd"].forEach(i=>$("#"+i).oninput=renderNotes);
function showNote(t){const n=DB.notes.find(x=>x.t==t);openM(`<h2>${n.t}</h2><p class="mu">${n.c} · ${n.d}</p>`+layer("Short summary",n.s,1)+layer("Detailed explanation",n.x)+layer("Important facts",n.f)+layer("Important dates",n.dt)+layer("Important people",n.p)+layer("Key terms",n.k)+layer("Exam points",n.e)+layer("Further reading",n.r)+srcBox())}
/* ===== COMPARE ===== */
const opts=DB.countries.map(c=>`<option>${c.name}</option>`).join("");$("#ca").innerHTML=opts;$("#cb").innerHTML=opts;$("#cb").selectedIndex=1;
function compare(){const a=DB.countries.find(c=>c.name==$("#ca").value),b=DB.countries.find(c=>c.name==$("#cb").value);$("#ctab").innerHTML=`<tr><th></th><th>${a.name}</th><th>${b.name}</th></tr>`+CL.filter(r=>r[0]!="cap").map(r=>`<tr><td><b>${r[1]}</b></td><td>${a[r[0]]}</td><td>${b[r[0]]}</td></tr>`).join("")}
$("#ca").onchange=$("#cb").onchange=compare;compare();
/* ===== TIMELINE ===== */
$("#tl").innerHTML=DB.timeline.map(e=>`<div class="card" onclick="this.querySelector('.x').hidden=!this.querySelector('.x').hidden"><span class="yr">${e[0]}</span><h3>${e[1]}</h3><p class="x" hidden>${e[2]}</p><p class="mu" style="font-size:.8rem">Tap to expand</p></div>`).join("");
/* ===== LEARN ===== */
const MODES=["MCQ quiz","Flashcards","Capital quiz","Timeline quiz"];let mode=0,qi=0,score=0,done=false;
$("#qm").innerHTML=MODES.map((m,i)=>`<button class="btn g" onclick="setMode(${i})">${m}</button>`).join("");
const shuf=a=>[...a].sort(()=>Math.random()-.5);
function setMode(i){mode=i;qi=0;score=0;qz()}
function items(){if(mode==0)return DB.quiz;if(mode==2)return DB.countries.map(c=>{const w=shuf(DB.countries.filter(x=>x!=c)).slice(0,3).map(x=>x.cap),o=shuf([...w,c.cap]);return["Capital of "+c.name+"?",o,o.indexOf(c.cap),c.cap+" is the capital of "+c.name+"."]});return DB.timeline.slice(0,10).map(e=>{const w=shuf(DB.timeline.filter(x=>x!=e)).slice(0,3).map(x=>x[1]),o=shuf([...w,e[1]]);return["What happened in "+e[0]+"?",o,o.indexOf(e[1]),e[2]]})}
let cur=[];
function qz(){const b=$("#qbox");if(mode==1){const t=DB.terms[qi%DB.terms.length];b.innerHTML=`<div class="fc" id="fc" tabindex="0" onclick="this.innerHTML='${t.v.replace(/'/g,"\\'")}'"><b>${t.k}</b></div><p class="mu">Tap the card to reveal the definition.</p><button class="btn" onclick="qi++;qz()">Next card</button>`;return}
if(qi==0)cur=items();if(qi>=cur.length){b.innerHTML=`<h3>Score: ${score} / ${cur.length}</h3><button class="btn" onclick="setMode(mode)">Try again</button>`;return}
const q=cur[qi];b.innerHTML=`<p class="mu">Question ${qi+1} of ${cur.length}</p><h3>${q[0]}</h3>`+q[1].map((o,i)=>`<button class="opt" onclick="ans(${i},this)">${o}</button>`).join("")+`<div id="ex"></div>`}
function ans(i,el){const q=cur[qi];if($("#ex").innerHTML)return;const ok=i==q[2];if(ok)score++;el.classList.add(ok?"ok":"no");$$(".opt")[q[2]].classList.add("ok");$("#ex").innerHTML=`<p>${ok?"Correct.":"Not quite."} ${q[3]}</p><button class="btn" onclick="qi++;qz()">Next</button>`}
setMode(0);
/* ===== GLOSSARY ===== */
function renderGl(){const f=$("#gq").value.toLowerCase();$("#gl").innerHTML=DB.terms.filter(t=>(t.k+t.v).toLowerCase().includes(f)).sort((a,b)=>a.k.localeCompare(b.k)).map(t=>`<div class="card" style="cursor:default;margin-bottom:.6rem"><h3>${t.k}</h3><p>${t.v}</p></div>`).join("")}
$("#gq").oninput=renderGl;
/* ===== GLOBAL SEARCH ===== */
function searchAll(q){q=q.toLowerCase().trim();if(!q)return[];const all=[...DB.countries.map(c=>({t:c.name,c:"Country",d:c.gov+". "+c.strat,f:()=>showCountry(c.name),h:c.name+" "+c.strat+" "+c.issues})),...DB.topics.map((t,i)=>({t:t.name,c:"Geopolitics",d:t.simple,f:()=>showTopic(i),h:t.name+" "+t.detail+t.terms})),...DB.conflicts.map((c,i)=>({t:c.name,c:"Conflict",d:c.bg,f:()=>showConflict(i),h:c.name+c.bg+c.actors})),...DB.notes.map(n=>({t:n.t,c:"Note",d:n.s,f:()=>showNote(n.t),h:n.t+n.s+n.k})),...DB.terms.map(g=>({t:g.k,c:"Glossary",d:g.v,f:()=>{location.hash="#glossary";$("#gq").value=g.k;renderGl()},h:g.k+g.v}))];return all.map(x=>({...x,r:(x.t.toLowerCase().includes(q)?3:0)+(x.h.toLowerCase().includes(q)?1:0)})).filter(x=>x.r).sort((a,b)=>b.r-a.r).slice(0,12)}
let SR=[];$("#q").oninput=e=>{SR=searchAll(e.target.value);$("#results").innerHTML=e.target.value?`<h2 class="t">Results</h2><div class="grid">${SR.map((r,i)=>`<div class="card" onclick="SR[${i}].f()"><h3>${esc(r.t)}</h3><p><span class="tag ANALYSIS">${r.c}</span><span class="mu">Relevance ${r.r==4?"high":"medium"}</span></p><p>${esc(r.d.slice(0,110))}</p></div>`).join("")||"<p class='mu'>No results. Try a country, treaty or term.</p>"}</div>`:""};
/* ===== HOME ===== */
const pick=DB.topics[new Date().getDate()%DB.topics.length];
$("#homebody").innerHTML=`<h2 class="t">Topic of the day</h2><div class="card" onclick="showTopic(${DB.topics.indexOf(pick)})"><h3>${pick.name}</h3><p>${pick.simple}</p></div>
<h2 class="t">Trending topics</h2><div class="grid">${["Sanctions","Maritime geopolitics","Energy geopolitics","Strategic resources"].map(n=>{const i=DB.topics.findIndex(t=>t.name==n);return`<div class="card" onclick="showTopic(${i})"><h3>${n}</h3><p>${DB.topics[i].simple}</p></div>`}).join("")}</div>
<h2 class="t">Featured research</h2><div class="card" onclick="location.hash='#research'"><h3>Why is the Strait of Malacca important?</h3><p>A ten-part structured answer: quick answer to sources.</p></div>
<h2 class="t">Latest world developments</h2><div class="card" style="cursor:default"><p>Live news feed placeholder: connect a news API or RSS service in the API layer.</p></div>
<h2 class="t">Popular countries</h2><div class="grid">${["India","China","United States","Russia"].map(n=>{const c=DB.countries.find(x=>x.name==n);return`<div class="card" onclick="showCountry('${n}')"><h3>${n}</h3><p>${c.cap} · ${c.pop}</p></div>`}).join("")}</div>
<h2 class="t">Geopolitical hotspots</h2><div class="grid">${DB.conflicts.map((c,i)=>`<div class="card" onclick="showConflict(${i})"><h3>${c.name}</h3><p>${c.status}</p></div>`).join("")}</div>`;
renderCountries();renderNotes();renderGl();route();
</script></body></html>
